# ====================================================
#              Mega Leecher — Config File
# ====================================================
# 1. Copy this file:  cp config.env.example config.env
# 2. Fill in your values below
# 3. Never share or commit config.env
# ====================================================


# ---------- Telegram Bot Credentials ----------
# Get from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your personal Telegram numeric user ID
# Send /start to @userinfobot to get it
ADMIN_ID=your_numeric_user_id_here

# Telegram username shown to users for purchasing subscription
PURCHASE_USERNAME=@your_username_here


# ---------- Google OAuth Credentials (optional) ----------
# Required only if you want Google Drive support
# Get from https://console.cloud.google.com
# Create OAuth 2.0 credentials (Web application type)
# Add redirect URI: http://localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------- Installation Path ----------
# Absolute path to the directory where Mega Leecher is installed
INSTALL_DIR=/opt/mega-leecher
