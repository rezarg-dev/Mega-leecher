# Reference unit for manual installs. setup.sh writes its own copy.
[Unit]
Description=Mega Leecher Telegram Bot
Documentation=https://github.com/rezarg-dev/Mega-leecher
After=network-online.target bgutil-pot-provider.service
Wants=network-online.target bgutil-pot-provider.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mega-leecher
ExecStart=/opt/mega-leecher/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
